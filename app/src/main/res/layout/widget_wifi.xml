<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_surface"
    android:padding="16dp">

    <!-- Wi-Fi / Hotspot Indicator Bitmap (Top-Right) -->
    <ImageView
        android:id="@+id/iv_wifi_indicator"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:scaleType="fitCenter"
        android:contentDescription="Network Indicator" />

    <!-- SSID & Status (Bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginEnd="42dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_wifi_ssid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Home Fibre 5G"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_wifi_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Good signal"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
